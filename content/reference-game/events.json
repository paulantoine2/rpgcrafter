    "event.demo-path": {
      "id": "event.demo-path",
      "pages": [
        {
          "actions": [
            {
              "type": "dialogue",
              "speaker": "Cartographe",
              "text": "Le sentier et la passerelle sont deux plans indépendants. Traverse leur jonction au centre : seule cette connexion explicite permet de changer de plan. Les fosses bloquent une cellule entière, tandis que les palissades ne ferment que certains bords."
            }
          ]
        }
      ]
    },
    "event.demo-gallery": {
      "id": "event.demo-gallery",
      "pages": [
        {
          "actions": [
            {
              "type": "dialogue",
              "speaker": "Veilleur de la galerie",
              "text": "La terrasse existe aussi au-dessus de ces mêmes coordonnées. En restant dans la galerie, tu passes derrière sa surface et les créatures qui s’y trouvent ne peuvent ni te voir ni te toucher. La rampe commence juste à l’est."
            }
          ]
        }
      ]
    },
    "event.demo-terrace": {
      "id": "event.demo-terrace",
      "pages": [
        {
          "actions": [
            {
              "type": "dialogue",
              "speaker": "Sonneur des cloches",
              "text": "Tu es maintenant sur le plan de la terrasse : son sol est rendu sous tes pas, puis ton personnage apparaît devant. Le parapet est un calque aboveActors et les éléments de la galerie restent sur leur propre plan."
            }
          ]
        }
      ]
