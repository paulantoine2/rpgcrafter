        }
      ],
      "text": "Parlez au maire d'Aubeval."
    },
    {
      "conditions": [
        {
          "kind": "quest",
          "id": "quest.bell-of-mist",
          "state": "reach_sanctuary"
        }
      ],
      "text": "Traversez le Sentier et trouvez la clé du Sanctuaire."
    },
    {
      "conditions": [
        {
          "kind": "quest",
          "id": "quest.bell-of-mist",
          "state": "open_door"
        }
      ],
      "text": "Ouvrez la porte du Gardien."
    },
    {
      "conditions": [
        {
          "kind": "quest",
          "id": "quest.bell-of-mist",
          "state": "defeat_guardian"
        }
      ],
      "text": "Vainquez le Gardien noyé."
    },
    {
      "conditions": [
        {
          "kind": "quest",
          "id": "quest.bell-of-mist",
          "state": "return_to_mayor"
        }
      ],
      "text": "Rapportez le Cœur de cristal au maire."
    },
    {
      "conditions": [
        {
          "kind": "quest",
          "id": "quest.bell-of-mist",
          "state": "completed"
        }
      ],
      "text": "La brume se dissipe. Votre aventure est terminée."
    }
  ],
  "events": {
    "event.mayor": {
      "id": "event.mayor",
      "pages": [
        {
          "conditions": [
            {
              "kind": "quest",
              "id": "quest.bell-of-mist",
              "state": "inactive"
            }
          ],
          "actions": [
            {
              "type": "dialogue",
              "speaker": "Maire Elian",
              "text": "La Cloche protectrice a perdu son Cœur de cristal. Sans lui, la brume avalera Aubeval. Voulez-vous chercher le Gardien ?",
              "choices": [
                {
                  "label": "J’accepte",
                  "actions": [
                    {
                      "type": "setQuestState",
                      "id": "quest.bell-of-mist",
                      "state": "reach_sanctuary"
                    },
                    {
                      "type": "toast",
                      "text": "Quête commencée : La Cloche des Brumes"
                    },
                    {
                      "type": "save"
                    }
                  ]
                },
                {
                  "label": "Pas encore",
                  "actions": [
                    {
                      "type": "dialogue",
                      "speaker": "Maire Elian",
                      "text": "Je comprends. Revenez quand vous serez prêt."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "conditions": [
            {
              "kind": "quest",
              "id": "quest.bell-of-mist",
              "state": "return_to_mayor"
            },
            {
              "kind": "item",
              "id": "item.crystal-heart"
            }
          ],
          "actions": [
            {
              "type": "dialogue",
              "speaker": "Maire Elian",
              "text": "Le Cœur de cristal ! Aubeval vous doit beaucoup.",
              "choices": [
                {
                  "label": "Remettre le cristal",
                  "actions": [
                    {
                      "type": "removeItem",
                      "id": "item.crystal-heart"
                    },
                    {
                      "type": "setQuestState",
                      "id": "quest.bell-of-mist",
                      "state": "completed"
                    },
                    {
                      "type": "save"
                    },
                    {
                      "type": "dialogue",
                      "speaker": "Maire Elian",
                      "text": "La cloche sonne à nouveau. La brume se retire. Fin de la démo V0 !"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "conditions": [
            {
              "kind": "quest",
              "id": "quest.bell-of-mist",
              "state": "completed"
            }
          ],
          "actions": [
            {
              "type": "dialogue",
              "speaker": "Maire Elian",
              "text": "La cloche protège à nouveau notre village. Merci, héros."
            }
          ]
        },
        {
          "actions": [
            {
              "type": "dialogue",
              "speaker": "Maire Elian",
              "text": "Le sentier à l’est mène au Sanctuaire. Restez prudent."
            }
          ]
        }
      ]
    },
