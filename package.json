{
  "name": "rpgcrafter",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "pnpm run dev",
    "dev": "turbo run dev --filter=@rpgcrafter/studio",
    "dev:studio": "pnpm --filter @rpgcrafter/studio run dev",
    "dev:player": "pnpm --filter @rpgcrafter/player run dev",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm --recursive --if-present run check",
    "test": "pnpm --recursive --if-present run test"
  },
  "devDependencies": {
    "turbo": "^2.10.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
