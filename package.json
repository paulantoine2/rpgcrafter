{
  "name": "rpgcrafter",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "npm run dev",
    "dev": "node scripts/dev.mjs",
    "dev:studio": "npm run dev --workspace @rpgcrafter/studio",
    "dev:player": "npm run dev --workspace @rpgcrafter/player",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
